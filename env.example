# ============================================================================
# proxmox_rolling_update.py — fichier d'environnement exemple
# Copier vers /etc/proxmox-updater/proxmox.env (ou passer via --env-file),
# puis renseigner les valeurs. chmod 600, propriétaire root.
# Priorité des valeurs : variable d'environnement > ce fichier > défauts
# codés en dur dans le script.
# ============================================================================

# ── Connexion API Proxmox ──────────────────────────────────────────────────
# Nœud « graine » : point d'entrée initial. La liste complète des nœuds du
# cluster est DÉCOUVERTE automatiquement via l'API (GET /nodes) ; les noms
# Proxmox doivent être résolvables en DNS depuis la machine qui exécute le
# script. Si ce n'est pas le cas, figer la liste via PVE_API_HOSTS.
PVE_API_HOST=pve-node1.example.com

# (Optionnel) Liste CSV des hôtes API, dans l'ordre des nœuds. Vide ou absent
# => découverte automatique depuis le nœud graine.
#PVE_API_HOSTS=pve-node1.example.com,pve-node2.example.com,pve-node3.example.com

# Utilisateur + token API. Le token doit avoir les droits suffisants sur le
# cluster (lectures, migrations, reboot, ha-manager, ceph si présent).
PVE_API_USER=automation@pam
PVE_API_TOKEN_NAME=rolling-update
PVE_API_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Vérifier le certificat TLS de l'API ? (true/false — false si certificat
# auto-signé)
PVE_VERIFY_SSL=false

# ── Connexion SSH (apt, ha-manager, ceph, systemd) ──────────────────────────
PVE_SSH_USER=root
PVE_SSH_KEY=/etc/proxmox-updater/id_ed25519
PVE_SSH_PORT=22

# Passphrase de la clé SSH. Vide => clé sans passphrase.
# MODE NON SUPERVISÉ (cron/systemd) : utiliser une clé SANS passphrase,
# dédiée au script et restreinte dans authorized_keys des nœuds :
#   from="<ip_worker>",no-pty,no-port-forwarding,no-X11-forwarding,no-agent-forwarding ssh-ed25519 AAAA...
PVE_SSH_PASSPHRASE=

# ── Migration des VMs à disques LOCAUX ──────────────────────────────────────
# true : la live migration des VMs dont les disques ne sont PAS sur un
# storage partagé migre aussi les disques (avec state, downtime courte).
# false : ces VMs ne sont PAS migrées (elles restent sur leur nœud, le run
# le signale).
PVE_WITH_LOCAL_DISKS=true

# ── Ceph (optionnel — ignoré si le cluster n'a pas de Ceph) ─────────────────
# Tolérer HEALTH_WARN aux gates Ceph (post-reboot, gate avant
# évacuation/reboot, rééquilibrage). ATTENTION : affaiblit la protection
# anti-dégradation cumulée entre deux reboots (un PG peut se retrouver
# sous-répliqué, voire sous min_size, si un second nœud tombe pendant un
# recovery en cours) — à vos risques. Défaut : 0 (HEALTH_OK exigé partout).
#PVE_CEPH_ALLOW_WARN=0

# Tolérer les checks de sécurité cephx AUTH_INSECURE_* (Ceph ≥ 19.2.6,
# CVE-2025-30156 : clés CephX encore en « aes » ; 2 checks sont en
# sévérité ERR → HEALTH_ERR sans impact IO/daemons). Ces avis sont
# filtrés aux 3 gates Ceph ; toute dégradation RÉELLE (PG/OSD/MON)
# reste bloquante. Remédiation définitive : migrer les clés vers
# « aes256k ». Défaut : 0 (santé brute exigée).
#PVE_CEPH_ALLOW_AUTH_INSECURE=0

# Délai d'attente de convergence Ceph après un reboot de nœud, en secondes.
# Au-delà : échec si un mon/OSD est réellement down ; toléré si la
# récupération est en cours ET progresse (objets dégradés en baisse).
# À allonger sur un cluster de production. Défaut : 300.
#PVE_CEPH_POSTBOOT_TIMEOUT=300

# Délai d'attente HEALTH_OK avant d'évacuer/rebooter le nœud suivant
# (gate anti-dégradation cumulée), en secondes. Au-delà : refus de
# continuer (comportement sûr, le run s'arrête). À allonger si le
# recovery/backfill entre deux nœuds dépasse 15 minutes. Défaut : 900.
#PVE_CEPH_READY_TIMEOUT=900

# ── Estimation dry-run (durées du bilan final) ──────────────────────────────
# Paramètres du bilan « durée approximative du run » affiché en fin de
# dry-run. Surcharger uniquement si vos mesures terrain divergent des
# défauts — tout est optionnel, les valeurs ci-dessous sont les défauts.
# Vitesse de migration effective (Mo/s), état compris. Défaut : 250.
#PVE_EST_MIGRATE_SPEED_MBPS=250
# Overhead fixe par migration, en secondes (démarrage, handoff CRM,
# réveil des agents). Défaut : 60.
#PVE_EST_MIGRATE_OVERHEAD_S=60
# Durée d'un « apt update » par nœud, en minutes. Défaut : 2.
#PVE_EST_APT_MIN=2
# Durée d'un « apt full-upgrade » par nœud, en minutes. Défaut : 6.
#PVE_EST_UPGRADE_MIN=6
# Durée d'un reboot + retour Ceph complet par nœud, en minutes. Défaut : 9.
#PVE_EST_REBOOT_MIN=9

# ── Sorties & état du run ────────────────────────────────────────────────────
# (Optionnel) Fichier de log en parallèle de la console (sans ANSI,
# horodatage complet). --log-file en CLI reste prioritaire. Vide => aucun.
#PVE_LOG_FILE=/var/log/proxmox-rolling-update.log

# (Optionnel) Emplacement du fichier d'état du run (reprise après
# interruption). Par défaut : à côté du fichier de log, sinon dans le
# répertoire courant : proxmox-rolling-update.state.json
#PVE_STATE_FILE=/var/lib/proxmox-rolling-update/state.json
